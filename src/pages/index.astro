---
import body from "../content/body.html?raw";
import SiteHead from "../components/SiteHead.astro";
import HomeWaitlist from "../components/HomeWaitlist.astro";
import Sidebar from "../components/Sidebar.astro";
import { prepareLibrary } from "../lib/library.mjs";
import { asset } from "../lib/assets.mjs";
const library = prepareLibrary(body);
const description = `Explore ${library.total} animated UI examples with CSS snippets, ${library.counts.react} React examples, and ${library.counts.prompt} AI prompts. Preview, learn, and copy the code.`;
const renderedBody = library.html
  .replaceAll("{{effectCount}}", String(library.total))
  .replaceAll("{{reactCount}}", String(library.counts.react))
  .replaceAll("{{promptCount}}", String(library.counts.prompt));
const [beforeWaitlist, afterWaitlist] = renderedBody.split("<!-- pro-waitlist -->");
---
<!doctype html>
<html lang="en">
  <head><SiteHead title="Kinetics — CSS & React Spring Animation Examples" description={description} home /></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Sidebar />
    <div class="page-shell"><Fragment set:html={beforeWaitlist} /><HomeWaitlist /><Fragment set:html={afterWaitlist} /></div>
    <script is:inline defer src={asset("/js/search-index.js")}></script>
    <script is:inline defer src={asset("/js/motion-visibility.js")}></script>
    <script is:inline defer src={asset("/js/main.js")}></script>
    <script is:inline defer src={asset("/js/physics-demo.js")}></script>
    <script>import '../scripts/examples.js';</script>
  </body>
</html>
